# FastAPI backend base URL (server-only — never expose with NEXT_PUBLIC_)
API_URL=http://localhost:8000

# Number of proxies/load balancers in front of THIS Next app whose X-Forwarded-For entries are trusted.
# 0 = don't forward a client IP (local dev). On Vercel/most platforms use 1.
# Then set the backend's TRUSTED_PROXY_COUNT to count this app as one more hop.
FRONT_PROXY_COUNT=0

# Must match the backend's REFRESH_TOKEN_DAYS
REFRESH_TOKEN_DAYS=7

NEXT_PUBLIC_DISPLAY_TZ=Africa/Lagos

# Cookie Secure flag: unset = automatic (Secure only over HTTPS). Set true behind TLS-terminating proxies that do not send X-Forwarded-Proto.
# COOKIE_SECURE=true
